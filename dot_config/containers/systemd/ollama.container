# Ollama always-on LLM container (Tailscale-only)
# Created 2026-05-25 for ML Foundation Slice Plan 1 Task 6+7
# Spec: docs/cachyos-setup/specs/2026-05-24-ml-robotics-stack-design.md §5
# Not chezmoi-managed yet (cross-OS templating is a deferred sub-project).

[Unit]
Description=Ollama LLM service (always-on, Tailscale-only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Container]
ContainerName=ollama
Image=docker.io/ollama/ollama:latest
AutoUpdate=registry

# GPU via CDI
AddDevice=nvidia.com/gpu=all

# Bind only on Tailscale interface — never on public LAN
PublishPort=100.104.21.28:11434:11434

# Persistent model storage on @ml-data subvol (nodatacow inherited)
Volume=%h/ml-data/ollama-models:/root/.ollama:Z

# Tuning
Environment=OLLAMA_KEEP_ALIVE=10m

# One slot, not two: each parallel slot allocates its own KV cache. With a 17-24 GB
# model already spilling into RAM on a 16 GiB card, a second slot is what makes the
# spill unmanageable. Agentic clients (Claude Code, hutshub-chatbot) are sequential
# anyway — raise this only for a genuinely concurrent workload on a smaller model.
Environment=OLLAMA_NUM_PARALLEL=1

# Context sizing. Ollama's default (4096) silently truncates: Claude Code's system
# prompt on this setup measures 37464 tokens, so even 32768 lost the head of it and
# the model answered the system prompt instead of the user. Measured 2026-07-31:
#   gpt-oss:20b @ 64K  ->  15.1 GB, 100% on GPU, 168 tok/s
# The q8_0 cache below is what buys the headroom. Raising this further, or running a
# model whose weights exceed ~13 GB, pushes the KV cache off the card.
Environment=OLLAMA_CONTEXT_LENGTH=65536

# Roughly halves KV cache memory. flash_attention is a prerequisite for the
# quantized cache type — setting kv_cache_type alone is silently ignored.
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0

[Service]
TimeoutStartSec=600
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
